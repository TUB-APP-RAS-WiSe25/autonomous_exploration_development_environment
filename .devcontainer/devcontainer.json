{
  "name": "ROS2 Humble Devcontainer",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": ["--net=host"],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1",
    "XAUTHORITY": "/home/vscode/.Xauthority",
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=${localEnv:XAUTHORITY},target=/home/vscode/.Xauthority,type=bind"
  ],
  "containerUser": "vscode",
  "workspaceFolder": "/workspaces",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "twxs.cmake"
      ]
    }
  },
  "remoteUser": "vscode"
}
